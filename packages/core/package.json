{
  "name": "@eudikit/core",
  "version": "0.0.0",
  "description": "Framework-agnostic OpenID4VP relying-party engine for EUDI / Age Verification wallets",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./handler": {
      "types": "./dist/handler/index.d.ts",
      "default": "./dist/handler/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@openid4vc/openid4vp": "~0.5.4",
    "@owf/mdoc": "~0.7.0",
    "@sd-jwt/sd-jwt-vc": "~0.20.0",
    "dcql": "^3.0.0",
    "jose": "^6.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "eudi",
    "eidas",
    "openid4vp",
    "age-verification",
    "mdoc",
    "verifiable-credentials",
    "digital-credentials-api"
  ],
  "author": "Onur Eren Hanife <onurhnf@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Onurhnf/eudikit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Onurhnf/eudikit#readme",
  "bugs": {
    "url": "https://github.com/Onurhnf/eudikit/issues"
  }
}
